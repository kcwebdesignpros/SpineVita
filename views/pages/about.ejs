<section class="page-header">
  <div class="wrap">
    <span class="section-subtitle"><%- icon('users') %> About Us</span>
    <h1>Meet The SpineVita Chiropractic Team</h1>
    <p>Root-cause chiropractic care from a Kansas City team that listens first, treats second, and supports you for the long run.</p>
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> / <span>About Us</span>
    </nav>
  </div>
</section>

<section class="section about">
  <div class="wrap">
    <div class="about-grid">
      <div class="about-image">
        <img src="/images/about.webp" alt="SpineVita chiropractic clinic in Kansas City" width="600" height="520" />
      </div>
      <div class="about-content">
        <h2>Our Mission: Help Kansas City <b>Move Better</b> And <b>Live Healthier</b></h2>
        <p class="lead">SpineVita was founded on a simple belief: pain is a signal, not a life sentence. Our chiropractors combine clinical expertise with compassionate care to uncover the underlying cause of your symptoms.</p>
        <p>We serve patients across Kansas City, Overland Park, Independence, Leawood and surrounding communities. Whether you're recovering from an auto accident, struggling with sciatica, or preparing for childbirth, we meet you where you are and build a plan that fits your life.</p>
        <a href="/contact" class="btn btn-primary">Schedule a Consultation <span class="arw"><%- icon('arrow-right','ico-xs') %></span></a>
      </div>
    </div>

    <div class="values-grid">
      <div class="value-card hover-lift" data-reveal data-delay="1">
        <div class="ic"><%- icon('target') %></div>
        <h4>Root-Cause Care</h4>
        <p>We don't mask symptoms. We identify and treat the source of your pain.</p>
      </div>
      <div class="value-card hover-lift" data-reveal data-delay="2">
        <div class="ic"><%- icon('hand-heart') %></div>
        <h4>Patient-First</h4>
        <p>Every plan is personalized to your goals, lifestyle and comfort level.</p>
      </div>
      <div class="value-card hover-lift" data-reveal data-delay="3">
        <div class="ic"><%- icon('graduation-cap') %></div>
        <h4>Evidence-Based</h4>
        <p>We use proven techniques, modern diagnostics and ongoing education.</p>
      </div>
      <div class="value-card hover-lift" data-reveal data-delay="4">
        <div class="ic"><%- icon('heart-pulse') %></div>
        <h4>Whole-Body Wellness</h4>
        <p>Adjustments, movement, nutrition and habits that support total health.</p>
      </div>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="wrap text-center">
    <span class="section-subtitle"><%- icon('stethoscope') %> Our Team</span>
    <h2 class="display-3" style="margin-top:12px">Board-Certified Doctors You Can Trust</h2>
    <p class="lead" style="margin:16px auto 0">Our chiropractors bring decades of combined experience and a shared commitment to gentle, effective care.</p>

    <div class="team-grid" style="margin-top:44px">
      <div class="team-card hover-lift" data-reveal data-delay="1">
        <div class="img"><%- icon('user-round') %></div>
        <div class="txt">
          <h4>Dr. Marcus Chen</h4>
          <span>Lead Chiropractor</span>
        </div>
      </div>
      <div class="team-card hover-lift" data-reveal data-delay="2">
        <div class="img"><%- icon('user-round') %></div>
        <div class="txt">
          <h4>Dr. Sarah Williams</h4>
          <span>Prenatal & Sports Specialist</span>
        </div>
      </div>
      <div class="team-card hover-lift" data-reveal data-delay="3">
        <div class="img"><%- icon('user-round') %></div>
        <div class="txt">
          <h4>Dr. James Okonkwo</h4>
          <span>Spinal Decompression Expert</span>
        </div>
      </div>
      <div class="team-card hover-lift" data-reveal data-delay="4">
        <div class="img"><%- icon('user-round') %></div>
        <div class="txt">
          <h4>Dr. Emily Park</h4>
          <span>Rehab & Wellness Director</span>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="stats-row" data-reveal>
      <div class="stat-card"><div class="n" data-count="5000" data-suffix="+">5K+</div><div class="l">Satisfied Patients Treated</div></div>
      <div class="stat-card"><div class="n" data-count="12" data-suffix="+">12+</div><div class="l">Years of Excellence</div></div>
      <div class="stat-card"><div class="n" data-count="99" data-suffix="%">99%</div><div class="l">Patient Satisfaction Rate</div></div>
      <div class="stat-card"><div class="n" data-count="15" data-suffix="+">15+</div><div class="l">Certified & Trusted Team</div></div>
      <div class="stat-card"><div class="n">4.9<%- icon('star','stat-star') %></div><div class="l">Average Google Rating</div></div>
    </div>
  </div>
</section>
