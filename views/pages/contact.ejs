<section class="page-header">
  <div class="wrap">
    <span class="section-subtitle"><%- icon('message') %> Contact Us</span>
    <h1>Book Your Appointment Today</h1>
    <p>Ready to feel better? Call, email, or fill out the form below and our Kansas City team will respond within one business day.</p>
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> / <span>Contact</span>
    </nav>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="contact-grid">
      <div class="contact-info">
        <h2>We'd Love To Hear From You</h2>
        <p class="lead">Whether you're a new patient with questions or a returning patient ready to schedule, our team is here to help.</p>

        <div class="contact-card">
          <div class="ic"><%- icon('phone') %></div>
          <div>
            <b>Phone</b>
            <a href="tel:<%= business.phone %>"><%= business.phoneDisplay %></a>
          </div>
        </div>

        <div class="contact-card">
          <div class="ic"><%- icon('mail') %></div>
          <div>
            <b>Email</b>
            <a href="mailto:<%= business.email %>"><%= business.email %></a>
          </div>
        </div>

        <div class="contact-card">
          <div class="ic"><%- icon('map-pin') %></div>
          <div>
            <b>Address</b>
            <span><%= fullAddress %></span>
          </div>
        </div>

        <div class="contact-card">
          <div class="ic"><%- icon('clock') %></div>
          <div>
            <b>Clinic Hours</b>
            <span>Mon–Fri <%= business.hours.mon.replace('-', ' – ') %><br />Saturday <%= business.hours.sat.replace('-', ' – ') %><br />Sunday <%= business.hours.sun %></span>
          </div>
        </div>
      </div>

      <div class="contact-form">
        <div class="success-message" id="contactSuccess"<%= (typeof submitted !== 'undefined' && submitted) ? '' : ' hidden' %>>
          <h3>Thank You!</h3>
          <p>Your message has been received. A member of our Kansas City team will contact you within one business day.</p>
          <a href="/" class="btn btn-primary" style="margin-top:20px">Return Home <span class="arw"><%- icon('arrow-right','ico-xs') %></span></a>
        </div>

        <div class="success-message error-message" id="contactError" hidden>
          <h3>Something Went Wrong</h3>
          <p>We couldn't send your message just now. Please try again, or reach us directly at <a href="tel:<%= business.phone %>" style="color:var(--primary);font-weight:600"><%= business.phoneDisplay %></a>.</p>
          <a href="/contact" class="btn btn-primary" style="margin-top:20px">Try Again <span class="arw"><%- icon('arrow-right','ico-xs') %></span></a>
        </div>

        <div id="contactFormWrap"<%= (typeof submitted !== 'undefined' && submitted) ? ' hidden' : '' %>>
        <h3>Send Us A Message</h3>
        <form action="/contact" method="POST" aria-label="Contact form">
          <div class="form-group">
            <label for="name">Full Name</label>
            <input type="text" id="name" name="name" required placeholder="John Smith" />
          </div>
          <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" required placeholder="john@example.com" />
          </div>
          <div class="form-group">
            <label for="phone">Phone Number</label>
            <input type="tel" id="phone" name="phone" placeholder="(816) 555-0142" />
          </div>
          <div class="form-group">
            <label for="service">Service Interested In</label>
            <select id="service" name="service">
              <option value="">Select a service</option>
              <option value="auto-accident">Auto Accident Injury Care</option>
              <option value="sciatica">Sciatica & Nerve Pain</option>
              <option value="headache">Headache & Migraine Relief</option>
              <option value="sports">Sports Injury Rehab</option>
              <option value="prenatal">Prenatal Chiropractic</option>
              <option value="decompression">Spinal Decompression</option>
              <option value="general">General Chiropractic</option>
            </select>
          </div>
          <div class="form-group">
            <label for="message">How Can We Help?</label>
            <textarea id="message" name="message" required placeholder="Tell us about your symptoms or questions..."></textarea>
          </div>
          <button type="submit" class="btn btn-primary btn-lg" style="width:100%">Send Message <span class="arw"><%- icon('arrow-right','ico-xs') %></span></button>
        </form>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-alt map-section">
  <div class="wrap">
    <div class="map-head" data-reveal style="text-align:center;max-width:640px;margin:0 auto 40px">
      <span class="section-subtitle"><%- icon('map-pin') %> Find Us</span>
      <h2>Visit Our Kansas City Clinic</h2>
      <p class="lead" style="margin:12px auto 0">Conveniently located on Country Club Blvd with free on-site parking. Walk-ins welcome for new-patient consultations.</p>
    </div>
    <div class="map-embed" data-reveal>
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3105.123456789!2d-94.5786!3d39.0997!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMznCsDA1JzU4LjkiTiA5NMKwMzQnNDMuMCJX!5e0!3m2!1sen!2sus!4v1700000000000"
        width="100%"
        height="420"
        style="border:0"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="SpineVita Chiropractic clinic location on Google Maps">
      </iframe>
    </div>
    <div class="map-info-row">
      <div class="map-info-card" data-reveal data-delay="1">
        <div class="mic-icon"><%- icon('map-pin') %></div>
        <b>Our Address</b>
        <span><%= fullAddress %></span>
      </div>
      <div class="map-info-card" data-reveal data-delay="2">
        <div class="mic-icon"><%- icon('parking') %></div>
        <b>Free Parking</b>
        <span>On-site lot — enter from Country Club Blvd</span>
      </div>
      <div class="map-info-card" data-reveal data-delay="3">
        <div class="mic-icon"><%- icon('accessibility') %></div>
        <b>Accessibility</b>
        <span>Ground-floor entrance, ADA compliant</span>
      </div>
    </div>
  </div>
</section>
